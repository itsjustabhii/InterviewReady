# API base URL — leave empty to use Vite dev proxy (/api → http://localhost:5000/api)
# In production, set this to the full API origin e.g. https://api.interviewready.com/api
VITE_API_URL=

# Razorpay public key (test key for dev — get from https://dashboard.razorpay.com/)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
